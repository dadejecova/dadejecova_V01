{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Docker (Backend)",
      "type": "shell",
      "command": "docker-compose up --build -d",
      "options": {
        "cwd": "${workspaceFolder}/../portfolio-core-api"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "docker-tasks"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Docker (Backend)",
      "type": "shell",
      "command": "docker-compose down",
      "options": {
        "cwd": "${workspaceFolder}/../portfolio-core-api"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "docker-tasks"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "dev-tasks"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting.*$",
          "endsPattern": "^.*(Ready in|compiled).*$"
        }
      }
    },
    {
      "label": "Start Dev Environment",
      "dependsOn": [
        "Start Docker (Backend)",
        "Start Frontend"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
